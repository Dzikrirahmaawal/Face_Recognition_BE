# Copy to .env and replace every placeholder before running.
# Generate SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate BIOMETRIC_ENCRYPTION_KEY:
#   python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"

APP_NAME=Smart Visitor Attendance API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=smart-visitor-attendance
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Local SQL Server. Production must use a trusted TLS certificate and must not
# set TrustServerCertificate=yes (startup validation rejects it).
DATABASE_URL=mssql+pyodbc://sa:YourStrong!Passw0rd@localhost:1433/visitor_attendance?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# SQL Server container password used by docker-compose.yml.
# Keep it URL-safe because it is embedded in DATABASE_URL below; otherwise
# percent-encode it in the URL (for example, '@' becomes '%40').
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
# SQL Server memory target for small development hosts. Raise this when the
# host has enough RAM; keep it below the container/host memory ceiling.
MSSQL_MEMORY_LIMIT_MB=1024

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Development defaults. Production requires non-mock providers and a model path.
FACE_RECOGNITION_PROVIDER=mock
FACE_MODEL_PATH=
FACE_MODEL_VERSION=mock-v1
FACE_EMBEDDING_VERSION=1
FACE_MATCH_THRESHOLD=0.60
FACE_REVIEW_THRESHOLD=0.45
FACE_DUPLICATE_THRESHOLD=0.80
FACE_AMBIGUITY_MARGIN=0.05
FACE_MIN_FACE_SIZE=80
FACE_MIN_BLUR_SCORE=40.0
FACE_MIN_BRIGHTNESS=30.0
FACE_MAX_BRIGHTNESS=230.0
FACE_MAX_IMAGE_PIXELS=25000000

FACE_LIVENESS_PROVIDER=mock
FACE_LIVENESS_URL=
FACE_LIVENESS_API_KEY=
FACE_LIVENESS_TIMEOUT_SECONDS=10.0

# Required in production; must decode to exactly 32 bytes.
BIOMETRIC_ENCRYPTION_KEY=

RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
GLOBAL_RATE_LIMIT=300
GLOBAL_RATE_WINDOW_SECONDS=60

LOG_LEVEL=INFO
TIMEZONE=Asia/Jakarta
IDEMPOTENCY_TTL_HOURS=24
KIOSK_LAST_SEEN_UPDATE_SECONDS=60

VISITOR_RETENTION_DAYS=365
ATTENDANCE_RETENTION_DAYS=1095

# Never enable outside the automated test suite.
ALLOW_SQLITE_FOR_TESTS=false
